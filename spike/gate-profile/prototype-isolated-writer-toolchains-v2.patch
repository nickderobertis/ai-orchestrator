+def _isolation_log(kind: str, seconds: float) -> None:
+    """SPIKE PROTOTYPE: record one isolation step's cost, per test, when the harness asks."""
+    import json, os
+    log = os.environ.get("GATE_PROFILE_ISOLATION_LOG")
+    if log:
+        with open(log, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps({"test": os.environ.get("PYTEST_CURRENT_TEST", ""), "kind": kind,
+                                 "seconds": round(seconds, 4), "pid": os.getpid()}) + "\n")
+
+
+def isolated_python_root(destination: Path) -> Path:
+    """SPIKE PROTOTYPE: a copy of this checkout with its own node_modules and its own `.venv`.
+
+    For writers that re-provision the Python toolchain (session setup's `uv sync`): the
+    copy's `.venv` is synced from the lockfile, so nothing they run reaches this checkout's.
+    """
+    import os, time
+    copy_checkout(destination)
+    started = time.monotonic()
+    subprocess.run(["git", "init", "-q", str(destination)], check=True)
+    _isolation_log("git_init", time.monotonic() - started)
+    env = {k: v for k, v in os.environ.items() if k not in ("UV_PROJECT_ENVIRONMENT", "VIRTUAL_ENV", "UV_NO_SYNC")}
+    started = time.monotonic()
+    subprocess.run(["uv", "sync", "--locked", "--project", str(destination)], check=True, env=env,
+                   capture_output=True)
+    _isolation_log("venv_sync", time.monotonic() - started)
+    return destination
+
+
+def isolated_node_modules(destination: Path) -> None:
+    """SPIKE PROTOTYPE (isolated writer toolchains): give a copy a node_modules of its own.
+
+    A hardlinked tree (`cp -al`): package files share inodes with this checkout's install,
+    but every directory — `.bin` included — is the copy's own, so the in-sync Bun install
+    `scripts/nx.sh` runs in the copy re-links the copy's `.bin` and never this checkout's.
+    Measured at 0.69 s per copy, and no data blocks.
+    """
+    import time
+    started = time.monotonic()
+    subprocess.run(["cp", "-al", str(NODE_MODULES), str(destination / "node_modules")], check=True)
+    _isolation_log("node_modules_cp_al", time.monotonic() - started)
+
+
