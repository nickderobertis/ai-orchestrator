# Every checkout `just repos-apply` registers with `onevcs`, one path per line.
#
# Blank lines and `#` comments are ignored; a leading `~` expands against `$HOME`.
# Registration resolves each path's own `origin` to a repository identity, so the
# policy a checkout gets comes from `config/onevcs.rules.yml` matching that
# identity — not from anything written here. Several checkouts of one origin (a
# canonical checkout, a safety clone, an execution clone) therefore share one
# policy by construction.
#
# Always list the path. `onevcs` derives the alias from the checkout's directory
# name; an `owner/name` spelling passed here would be resolved as a GitHub
# repository of that name instead. See `docs/host-setup.md`.
#
# A path this host does not have is reported as skipped rather than failing the
# run, so a second machine registers the checkouts it does have.
#
# That is what the duplicate-looking entries below are. The two hosts this
# repository dispatches from lay the same checkouts out differently: one keeps its
# own clones at the top of `$HOME` and the engine repositories under `~/projects`,
# the other keeps everything under `~/projects` and lets the dispatcher clone the
# engines into `~/.ai-orchestrator/repos/<owner>__<name>`. Both spellings of each
# checkout are listed and each host registers the ones it has, so this stays one
# tracked source of truth rather than a per-host fork of one.

# This repository: the publication checkout, then the two safety clones every
# self-dispatch executes in.
# At the top of `$HOME` on one host, under `~/projects` on the other.
~/ai-orchestrator
~/ai-orchestrator-isolated
~/ai-orchestrator-isolated-2
~/projects/ai-orchestrator
~/projects/ai-orchestrator-isolated
~/projects/ai-orchestrator-isolated-2

# The published CLIs this repository configures — the four engines the recipes
# wrap, plus `llmlint`, whose judged tier this repository configures in
# `llmlint.yml` and drives from `just lint-llm-diff`.
# Each under whichever of the two layouts its host clones it into.
~/projects/oneagentgraph
~/projects/onepipeline
~/projects/onepipeline-ui
~/projects/onevcs
~/.ai-orchestrator/repos/nickderobertis__llmlint
~/.ai-orchestrator/repos/nickderobertis__oneagentgraph
~/.ai-orchestrator/repos/nickderobertis__oneharness
~/.ai-orchestrator/repos/nickderobertis__oneharness-ui
~/.ai-orchestrator/repos/nickderobertis__onejudge
~/.ai-orchestrator/repos/nickderobertis__onemessagebus
~/.ai-orchestrator/repos/nickderobertis__onepipeline
~/.ai-orchestrator/repos/nickderobertis__onepipeline-ui
~/.ai-orchestrator/repos/nickderobertis__onevcs

# Other repositories dispatched against from this host.
~/.ai-orchestrator/repos/nickderobertis__allowlister-remote
~/.ai-orchestrator/repos/nickderobertis__crozier
~/.ai-orchestrator/repos/nickderobertis__dero-skills
~/.ai-orchestrator/repos/nickderobertis__ev-trip-planner
~/.ai-orchestrator/repos/nickderobertis__nick-derobertis-site
~/.ai-orchestrator/repos/nickderobertis__notignored
~/.ai-orchestrator/repos/nickderobertis__onetaskgraph

# `printobserver`, which this host both publishes and executes in. The first entry is
# the publication checkout, spelled like every other entry in this block: a change is
# published from it, and it is never worked in directly — only fast-forwarded once a
# change has landed. The `-isolated` safety clone beside it is the execution checkout,
# which is what a run cuts its private clone from and creates its task worktree in —
# the same distinction `~/ai-orchestrator-isolated` makes above. Both resolve to one
# identity from their own `origin`, so the rule matching `printobserver` covers the
# pair.
~/.ai-orchestrator/repos/nickderobertis__printobserver
~/.ai-orchestrator/repos/nickderobertis__printobserver-isolated

~/.ai-orchestrator/repos/nickderobertis__screencomp
~/.ai-orchestrator/repos/nickderobertis__skilltest
~/.ai-orchestrator/repos/nickderobertis__spanish-language-tutor
~/.ai-orchestrator/repos/nickderobertis__vibe-stl
~/.ai-orchestrator/repos/petsinc__cd-chat-tool-call-challenge
~/.ai-orchestrator/repos/petsinc__hellopatient
~/.ai-orchestrator/repos/petsinc__referral-app
~/projects/notignored
~/projects/org-apps
