{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-setup.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just check)",
      "Bash(just test)",
      "Bash(just test-e2e)",
      "Bash(just lint)",
      "Bash(just format)",
      "Bash(just format-check)",
      "Bash(just typecheck)",
      "Bash(just upgrade)",
      "Bash(just sync)",
      "Bash(just validate-personas)",
      "Bash(just repo-recover:*)",
      "Bash(just register-repo:*)",
      "Bash(just repos:*)",
    "Bash(just goals:*)",
    "Bash(just results:*)",
    "Bash(just telemetry:*)",
            "Bash(just replan:*)",
      "Bash(just runs:*)",
      "Bash(just monitor:*)",
      "Bash(just status:*)",
      "Bash(just recoverable:*)",
      "Bash(just host:*)",
      "Bash(just channel-next:*)",
      "Bash(just channel-reply:*)",
      "Bash(just history:*)",
      "Bash(just history-show:*)",
      "Bash(just new-persona:*)",
      "Bash(just session-setup)",
      "Bash(just setup-llmlint)",
      "Bash(just lint-llm:*)",
      "Bash(just lint-llm-validate:*)",
      "Bash(just lint-llm-diff:*)",
      "Bash(llmlint:*)",
      "Bash(./scripts/setup-llmlint.sh)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(onejudge run:*)",
      "Bash(onejudge schema)",
      "Bash(onejudge init:*)",
      "Bash(oneharness detect)",
      "Bash(oneharness config:*)",
      "Bash(./scripts/session-setup.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git config core.bare)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)",
      "Bash(git -C * branch --list*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * merge-base*)",
      "Bash(git -C * remote -v)",
      "Bash(git -C * config core.bare)",
      "Bash(git clone:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": []
  }
}
