{
  "name": "telemetry-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/telemetry-client/src",
  "tags": ["scope:shared", "type:client"],
  "implicitDependencies": ["dag-model"],
  "targets": {
    "build": {
      "command": "bunx tsc -p packages/telemetry-client/tsconfig.json --emitDeclarationOnly",
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "command": "bunx biome check packages/telemetry-client && bunx eslint packages/telemetry-client"
    },
    "test": {
      "command": "bun test packages/telemetry-client/src packages/telemetry-client/e2e"
    },
    "typecheck": {
      "command": "bunx tsc -p packages/telemetry-client/tsconfig.json --noEmit"
    },
    "format": {
      "command": "bunx biome format --write packages/telemetry-client"
    },
    "format-check": {
      "command": "bunx biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false packages/telemetry-client"
    },
    "bootstrap": {
      "command": "bun install --frozen-lockfile"
    }
  }
}
