{
  "name": "dag-layout",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/dag-layout/src",
  "tags": ["scope:shared", "type:layout"],
  "targets": {
    "build": {
      "command": "bunx tsc -p packages/dag-layout/tsconfig.json --emitDeclarationOnly",
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "command": "bunx biome check packages/dag-layout && bunx eslint packages/dag-layout"
    },
    "test": {
      "command": "bun test packages/dag-layout/src packages/dag-layout/e2e"
    },
    "typecheck": {
      "command": "bunx tsc -p packages/dag-layout/tsconfig.json --noEmit"
    },
    "format": {
      "command": "bunx biome format --write packages/dag-layout"
    },
    "format-check": {
      "command": "bunx biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false packages/dag-layout"
    },
    "bootstrap": {
      "command": "bun install --frozen-lockfile"
    }
  }
}
