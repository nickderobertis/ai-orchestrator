{
  "name": "dag-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dag-ui/src",
  "tags": ["scope:app", "type:web"],
  "implicitDependencies": ["dag-layout", "dag-model", "telemetry-client"],
  "targets": {
    "serve": {
      "command": "cd apps/dag-ui && bunx vite --config vite.config.ts"
    },
    "build": {
      "command": "cd apps/dag-ui && bunx vite build --config vite.config.ts",
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "command": "bunx biome check apps/dag-ui && bunx eslint apps/dag-ui"
    },
    "test": {
      "command": "cd apps/dag-ui && bunx vitest run --config vite.config.ts && bunx playwright test --config playwright.config.ts",
      "inputs": [
        "default",
        "{workspaceRoot}/orchestrator/**/*",
        "{workspaceRoot}/tests/e2e/fake_oneharness.py",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ]
    },
    "typecheck": {
      "command": "bunx tsc -p apps/dag-ui/tsconfig.json --noEmit"
    },
    "format": {
      "command": "bunx biome format --write apps/dag-ui"
    },
    "format-check": {
      "command": "bunx biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false apps/dag-ui"
    },
    "bootstrap": {
      "command": "bun install --frozen-lockfile && cd apps/dag-ui && bunx playwright install chromium"
    }
  }
}
