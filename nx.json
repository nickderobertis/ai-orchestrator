{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".nx/cache",
  "parallel": 3,
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "wholeWorkspace": [
      "{workspaceRoot}/**/*"
    ],
    "codeWorkspace": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/docs/**/*",
      "!{workspaceRoot}/**/*.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ],
    "testSupport": [],
    "production": [
      "default"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "coverage": {
      "cache": false
    },
    "test-checkouts": {
      "cache": false
    },
    "test-pypi": {
      "cache": true
    },
    "test-docs": {
      "cache": true,
      "inputs": [
        "wholeWorkspace"
      ]
    },
    "test-recipes": {
      "cache": true,
      "inputs": [
        "recipeWorkspace"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "format": {
      "cache": false
    },
    "format-check": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        {
          "env": "LLMLINT_DIFF_BASE_SHA"
        },
        {
          "runtime": "llmlint fingerprint"
        }
      ]
    },
    "bootstrap": {
      "cache": false
    },
    "budgets": {
      "command": "./scripts/budgets.sh {projectRoot}/budgets.yaml",
      "options": {
        "cwd": "."
      },
      "metadata": {
        "description": "Cached, so it skips every budget labelled host: label each elapsed or host-reading budget host, and the uncached budgets-host target runs it. Neither target runs a budget labelled onepipeline or planning, which are measured once a change lands or a planning flow ends. A budget labelled accepted-overrun warns rather than fails when over (scripts/budgets.sh)."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        "{workspaceRoot}/config/onebudgetspec.version",
        "{workspaceRoot}/scripts/budgets.sh",
        "{workspaceRoot}/uv.lock"
      ]
    },
    "budgets-host": {
      "command": "./scripts/budgets-host.sh {projectRoot}/budgets.yaml",
      "options": {
        "cwd": "."
      },
      "cache": false
    },
    "validate-budgets": {
      "cache": false
    }
  }
}
