{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".nx/cache",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "wholeWorkspace": [
      "{workspaceRoot}/**/*"
    ],
    "codeWorkspace": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/docs/**/*",
      "!{workspaceRoot}/**/*.md"
    ],
    "nxCacheCheck": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/scripts/check-nx-cache.sh",
      "{workspaceRoot}/scripts/nx.sh",
      "{workspaceRoot}/scripts/preserved-log.sh",
      "{workspaceRoot}/scripts/install-lock.sh",
      "{workspaceRoot}/scripts/workspace-install.sh",
      "{workspaceRoot}/scripts/python-install.sh",
      "{workspaceRoot}/tests/fixtures/nx-cache/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ],
    "testSupport": [],
    "production": [
      "default"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "coverage": {
      "cache": false
    },
    "test-checkouts": {
      "cache": false
    },
    "test-pypi": {
      "cache": true
    },
    "test-docs": {
      "cache": true,
      "inputs": [
        "wholeWorkspace"
      ]
    },
    "test-recipes": {
      "cache": true,
      "inputs": [
        "recipeWorkspace"
      ]
    },
    "check-nx-cache": {
      "cache": true,
      "inputs": [
        "nxCacheCheck"
      ]
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "format": {
      "cache": false
    },
    "format-check": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        {
          "env": "LLMLINT_DIFF_BASE_SHA"
        },
        {
          "runtime": "./scripts/llmlint-fingerprint.sh"
        }
      ]
    },
    "bootstrap": {
      "cache": false
    },
    "budgets": {
      "command": "uv run onebudgetspec check {projectRoot}/budgets.yaml --exclude-label host --exclude-label onepipeline --exclude-label planning",
      "options": {
        "cwd": "."
      },
      "metadata": {
        "description": "Cached, so it skips every budget labelled host: label each elapsed or host-reading budget host, and the uncached budgets-host target runs it. Neither target runs a budget labelled onepipeline or planning, which are measured once a change lands or a planning flow ends."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        "{workspaceRoot}/config/onebudgetspec.version",
        "{workspaceRoot}/uv.lock"
      ]
    },
    "budgets-host": {
      "command": "uv run onebudgetspec check {projectRoot}/budgets.yaml --label host --exclude-label onepipeline --exclude-label planning",
      "options": {
        "cwd": "."
      },
      "cache": false
    },
    "validate-budgets": {
      "cache": false
    }
  }
}
