{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cacheDirectory": ".nx/cache",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "wholeWorkspace": ["{workspaceRoot}/**/*"],
    "codeWorkspace": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/docs/**/*",
      "!{workspaceRoot}/**/*.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    },
    "test-docs": {
      "cache": true,
      "inputs": ["wholeWorkspace"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default"]
    },
    "format": {
      "cache": false
    },
    "format-check": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        { "env": "LLMLINT_DIFF_BASE_SHA" },
        { "runtime": "./scripts/llmlint-fingerprint.sh" }
      ],
      "outputs": ["{workspaceRoot}/.nx/llmlint-diff"]
    },
    "bootstrap": {
      "cache": false
    }
  }
}
