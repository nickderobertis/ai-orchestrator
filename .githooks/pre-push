#!/usr/bin/env bash
# Pre-push gate. With no CI, this is the enforcement point: nothing lands on the
# remote without passing llmlint's validate, then its LLM-judge tier, then the
# deterministic checks — `just gate`, cheapest refusal first.
# Activated by `just bootstrap` (git config core.hooksPath .githooks).
set -euo pipefail

if ! command -v llmlint >/dev/null 2>&1; then
  echo "pre-push: llmlint not installed — run 'just setup-llmlint' to enable the LLM-judge gate" >&2
  exit 1
fi

remote=${1:-origin}
# The base the *worker's* gate cleared, so this hook replays that verdict instead of
# re-rolling a non-deterministic judge against a base it resolved itself. `onevcs`
# is what exports it now, under its own name; `scripts/comparison-base.sh` carries
# the same precedence and says why.
base=${ORCHESTRATOR_COMPARISON_BASE:-${ONEVCS_COMPARISON_BASE:-}}
hook_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
updates=$(mktemp)
trap 'rm -f "$updates"' EXIT
cat >"$updates"

# Git exports repository-local GIT_* variables to hooks. The gate's realistic
# tests create and drive other repositories, so leaking those values makes every
# nested git command target this checkout instead of its requested cwd. The hook
# already runs from the worktree root; clear only Git's documented local set and
# let commands rediscover this repository from cwd.
while IFS= read -r name; do
  if [ -n "$name" ]; then
    unset "$name"
  fi
done < <(git rev-parse --local-env-vars)

echo "pre-push: complete gate (comparison remote=$remote${base:+ base=$base})..." >&2
comparison=$("$hook_root/scripts/comparison-base.sh" "$remote" "$base")
# A publication runs this hook in a worktree `onevcs` cut for it, which no session start
# provisioned, and nothing but session setup installs (AGENTS.md, "The checks"). So the
# gate's toolchain comes from session setup's own provisioning, scoped to this checkout
# and nothing about the host. Unconditional, since its locked installs change nothing on a
# tree that already matches. The follow-up "onevcs provisions a session or publication
# worktree when it opens one" tracks the library seam that retires this call.
"$hook_root/scripts/session-setup.sh" --provision-only
if "$hook_root/scripts/pre-push-smoke-needed.sh" "$comparison" <"$updates"; then
  echo "pre-push: launch path changed; running one real-harness smoke..." >&2
  just smoke
fi

# This gate is what a `local-direct` publication runs inside the clone it holds under
# `onevcs`'s merge-queue lock, so how long it takes is how long every sibling waiting to
# publish this identity is queued. Nobody can keep that number current by hand, so it is
# measured here, where the gate already runs, and every process that starts a waiter's
# `onevcs` derives its bound from the recording (ai-orchestrator#1164). The wrapper
# returns the gate's own status, so what this hook admits is unchanged.
#
# The push is then held to the root `budgets.yaml`, whose `gate-time` budget is that same
# recorded duration; `scripts/gate-budgets.sh` says how the step measures once and what
# it refuses. Over `gate-time`, labelled `host-variable`, warns rather than refuses: gate
# wall clock on a shared, variably loaded host is not a consistent measurement, so a
# strict absolute threshold belongs on a consistent system such as a CI runner. A failed
# gate, an errored measurement, or over any other root budget still refuses the push —
# among them `gate-leftovers`, `gate-peak-temp-disk` and `gate-leaked-processes`, which the
# same gate run records through `orchestrator/gate_impact.py`: what it left on the host,
# its peak temporary disk, and the processes that outlived it.
# shellcheck source=scripts/gate-budgets.sh
. "$hook_root/scripts/gate-budgets.sh"
# llmlint: ignore[changed_behavior_has_e2e] Driving this line would run the complete gate, which ai-orchestrator#1164 rejects as a second test; tests/e2e/budget_gate/test_gate_time_budget_e2e.py drives gate_within_budgets itself with a stand-in gate of known duration, tests/e2e/budget_gate/test_gate_host_impact_e2e.py drives it with stand-in gates that leave files, hold disk and leak processes for the gate-leftovers, gate-peak-temp-disk and gate-leaked-processes budgets, and every publication of this repository runs this line for real.
gate_within_budgets "$hook_root/budgets.yaml" just gate "$remote" "$base"
