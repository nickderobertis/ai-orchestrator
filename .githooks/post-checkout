#!/usr/bin/env bash
# Mark the directory git just checked out as trusted for every claude-code identity a
# dispatch of this host can run as — both alternate subscriptions and the primary,
# which is the last candidate on every harness chain and so the one reached exactly
# when the alternates are exhausted.
#
# claude-code keys `hasTrustDialogAccepted` on the EXACT project path and does not
# honour a parent entry — registering `~/.onevcs/workspaces` was measured not to cover
# its children. Every dispatch works in a worktree `onevcs` cut moments earlier, so
# without this every dispatch began untrusted: claude-code discards
# `permissions.allow` and the turn blocks on an approval that cannot arrive
# non-interactively, which reads from outside as an identity with quota left doing
# nothing. docs/host-setup.md records the measurement.
#
# This is the hook rather than a new `onevcs` interface because git already fires
# `post-checkout` exactly where a directory appears: `git worktree add` runs it in the
# new worktree, and `onevcs` gives a disposable clone the lender's `core.hooksPath`.
# `just bootstrap` activates it with its two siblings — `core.hooksPath` names this
# directory, not a file — so it needs no upstream change and no new interface.
#
# It never fails and never speaks, which is load-bearing rather than tidy. A
# `post-checkout` hook that exits non-zero fails the command that ran it: measured on
# this host's git, `git worktree add` exits with the hook's own status and `git
# checkout` exits 1. So a configuration that is absent, unreadable, or already correct
# has to be a silent success, or a convenience breaks every branch switch an operator
# makes and every worktree this host cuts. Nothing is lost with the silence: session
# setup makes this same call at the start of every session and reports what it finds
# there, where a diagnostic reaches somebody able to act on it.
#
# `set -e` is omitted deliberately: nothing below may abort this shell.
set -uo pipefail

# Git's third argument is 1 for a branch checkout and 0 for a file checkout. A file
# checkout rewrites files inside a directory that already existed and was already
# whatever it was; only a branch checkout — which is what `git worktree add` and `git
# clone` also report — can present a directory nothing has trusted yet.
[ "${3-}" = 1 ] || exit 0

# The hook's own tree, not the checked-out one. With `core.hooksPath` pointed at a
# lender's `.githooks`, as the lifecycle points a per-run clone, those are different
# directories and the helper is the lender's. Both spellings of `$0` reach it: git
# passes an absolute path under `git worktree add` and a path relative to the working
# tree root under an ordinary `git checkout`. A hooks directory reached without its
# repository resolves to no helper, and that is the same silent success as the rest.
hook_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd -P)
trust_helper="$hook_root/scripts/claude-workspace-trust.sh"
[ -x "$trust_helper" ] || exit 0

# Git runs this hook from the root of the working tree it just updated, and that is
# the directory a dispatch launches claude-code in. Physical, because `getcwd` is what
# reports the harness's own directory back to it whatever spelling it was launched
# under.
#
# The one implementation of this write, reached through its own entry point:
# `scripts/session-setup.sh` marks its checkout by calling into the same file, so which
# configurations there are, the lock, the pruning, and the shape validation are shared
# rather than reimplemented here and left to drift.
"$trust_helper" "$(pwd -P)" >/dev/null 2>&1 || true
exit 0
