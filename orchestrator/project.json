{
  "name": "orchestrator",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "orchestrator",
  "tags": ["language:python", "scope:orchestration"],
  "targets": {
    "build": {
      "command": "uv build",
      "options": {
        "cwd": "."
      },
      "outputs": ["{workspaceRoot}/dist"]
    },
    "lint": {
      "command": "uv run ruff check . && shellcheck scripts/*.sh .githooks/pre-push && uv run orchestrator-validate-personas && bun eslint . && bun biome lint .",
      "options": {
        "cwd": "."
      }
    },
    "test": {
      "command": "uv run pytest --cov=orchestrator --cov-report=term-missing --cov-fail-under=95",
      "options": {
        "cwd": "."
      },
      "outputs": ["{workspaceRoot}/.coverage"]
    },
    "typecheck": {
      "command": "uv run mypy",
      "options": {
        "cwd": "."
      }
    },
    "format": {
      "command": "uv run ruff format . && bun biome format --write .",
      "options": {
        "cwd": "."
      },
      "cache": false
    },
    "format-check": {
      "command": "uv run ruff format --check . && bun biome format .",
      "options": {
        "cwd": "."
      }
    }
  }
}
