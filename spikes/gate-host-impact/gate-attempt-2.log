n":"Terse, evidence-citing justification, written before `relevant`/`holds`: why the rule is (or isn't) relevant, and — when relevant — the verdict.","minLength":1,"type":"string"},"relevant":{"description":"Whether this rule applies to the change. Decide before the verdict; when false, omit `holds`/`violations`.","type":"boolean"},"violations":{"items":{"additionalProperties":false,"properties":{"end_line":{"minimum":1,"type":"integer"},"file":{"type":"string"},"line":{"minimum":1,"type":"integer"},"message":{"type":"string"}},"required":["file","line"],"type":"object"},"type":"array"}},"required":["name","rationale","relevant"],"then":{"required":["holds"]},"type":"object"},"protocol_based_seams":{"additionalProperties":false,"if":{"properties":{"relevant":{"const":true}},"required":["relevant"]},"properties":{"holds":{"type":"boolean"},"name":{"const":"protocol_based_seams","type":"string"},"rationale":{"description":"Terse, evidence-citing justification, written before `relevant`/`holds`: why the rule is (or isn't) relevant, and — when relevant — the verdict.","minLength":1,"type":"string"},"relevant":{"description":"Whether this rule applies to the change. Decide before the verdict; when false, omit `holds`/`violations`.","type":"boolean"},"violations":{"items":{"additionalProperties":false,"properties":{"end_line":{"minimum":1,"type":"integer"},"file":{"type":"string"},"line":{"minimum":1,"type":"integer"},"message":{"type":"string"}},"required":["file","line"],"type":"object"},"type":"array"}},"required":["name","rationale","relevant"],"then":{"required":["holds"]},"type":"object"},"structural_pattern_matching":{"additionalProperties":false,"if":{"properties":{"relevant":{"const":true}},"required":["relevant"]},"properties":{"holds":{"type":"boolean"},"name":{"const":"structural_pattern_matching","type":"string"},"rationale":{"description":"Terse, evidence-citing justification, written before `relevant`/`holds`: why the rule is (or isn't) relevant, and — when