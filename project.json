{
  "name": "workspace",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:workspace"],
  "targets": {
    "lint-llm-diff": {
      "command": "llmlint --diff --diff-base \"$LLMLINT_DIFF_BASE_SHA\"",
      "options": { "cwd": "." }
    },
    "validate-budgets": {
      "command": "uv run onebudgetspec validate --recursive .",
      "options": { "cwd": "." }
    }
  }
}
