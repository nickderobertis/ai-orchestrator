{
  "name": "judge-grant",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/judge_grant",
  "tags": [
    "scope:judge-grant",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-short-state",
    "support-waits"
  ],
  "namedInputs": {
    "judgeGrant": [
      "{projectRoot}/project.json",
      "{workspaceRoot}/tests/judge_grant/test_judge_grant_real_cli_e2e.py",
      "{workspaceRoot}/oneharness.judge.toml",
      "{workspaceRoot}/oneharness.dispatch.toml",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/scripts/decline-ruling.sh",
      "{workspaceRoot}/config/oneharness.version",
      "{workspaceRoot}/config/onepipeline.version",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/orchestrator/root.py"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/judge_grant --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "judgeGrant",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
