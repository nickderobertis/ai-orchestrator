{
  "name": "host-sweep",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/host_sweep",
  "tags": [
    "scope:host-sweep",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-published-tools",
    "support-waits"
  ],
  "namedInputs": {
    "hostSweepWorkspace": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/config/**/*.version",
      "{workspaceRoot}/config/onevcs.checkouts",
      "{workspaceRoot}/scripts/session-setup.sh",
      "{workspaceRoot}/scripts/host-sweep.sh",
      "{workspaceRoot}/scripts/setup-llmlint.sh",
      "{workspaceRoot}/scripts/repos-bootstrap.sh",
      "{workspaceRoot}/scripts/registered-checkouts.sh",
      "{workspaceRoot}/tests/host_sweep/**/*",
      "{workspaceRoot}/orchestrator/root.py"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/host_sweep --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "hostSweepWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
