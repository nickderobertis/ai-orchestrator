{
  "name": "support-provisioning",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "type:test-support"
  ],
  "implicitDependencies": [
    "support-offline-installs"
  ],
  "namedInputs": {
    "testSupport": [
      "{workspaceRoot}/tests/e2e/provisioning.py",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/config/*.version",
      "{workspaceRoot}/config/onevcs.checkouts",
      "{workspaceRoot}/scripts/session-setup.sh",
      "{workspaceRoot}/scripts/host-sweep.sh",
      "{workspaceRoot}/scripts/setup-llmlint.sh",
      "{workspaceRoot}/scripts/repos-bootstrap.sh",
      "{workspaceRoot}/scripts/registered-checkouts.sh",
      "{workspaceRoot}/scripts/workspace-install.sh",
      "{workspaceRoot}/scripts/install-lock.sh",
      "{workspaceRoot}/scripts/preserved-log.sh",
      "{workspaceRoot}/scripts/require-provisioned.sh",
      "{workspaceRoot}/orchestrator/root.py",
      "{projectRoot}/project.json"
    ]
  },
  "targets": {
    "test-support": {
      "executor": "nx:noop",
      "inputs": [
        "testSupport"
      ]
    }
  }
