{
  "name": "family-scans",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/family_scans",
  "tags": [
    "scope:family-scans",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-follow-up-variables",
    "support-nx-inputs",
    "support-onejudge-bundle",
    "support-onevcs-state-snapshot",
    "support-plan-fixture-source",
    "support-plan-root-variable",
    "support-plan-sources",
    "support-published-tools",
    "support-registered-checkouts",
    "support-short-state",
    "support-waits"
  ],
  "namedInputs": {
    "familyScansWorkspace": [
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/AGENTS.md",
      "{workspaceRoot}/config/**/*",
      "{workspaceRoot}/docs/**/*",
      "{workspaceRoot}/orchestrator/**/*",
      "{workspaceRoot}/personas/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/templates/**/*",
      "{workspaceRoot}/tests/test_plan_budgets_template.py",
      "{workspaceRoot}/tests/family_scans/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 COVERAGE_FILE=.coverage.family-scans uv run pytest tests/family_scans -n 4 --dist loadgroup --cov=orchestrator --cov-report= --cov-fail-under=0",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.coverage.family-scans"
      ],
      "inputs": [
        "familyScansWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
