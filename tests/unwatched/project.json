{
  "name": "unwatched",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/unwatched",
  "tags": [
    "scope:unwatched",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-budget-telemetry",
    "support-conftest",
    "support-fake-backend",
    "support-fake-codex",
    "support-harness-indirections",
    "support-no-paid-provider",
    "support-nx-workspace",
    "support-plan-fixture-source",
    "support-probe-run-root",
    "support-project-fixtures",
    "support-run-snapshot",
    "support-scratch-identity",
    "support-served-recipe",
    "support-short-state",
    "support-waits"
  ],
  "namedInputs": {
    "unwatchedWorkspace": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/oneharness.check-in.toml",
      "{workspaceRoot}/oneharness.pr-author.toml",
      "{workspaceRoot}/oneharness.review-reply.toml",
      "{workspaceRoot}/config/oneagentgraph.version",
      "{workspaceRoot}/config/oneharness.version",
      "{workspaceRoot}/config/onejudge.version",
      "{workspaceRoot}/config/onemessagebus.yaml",
      "{workspaceRoot}/config/onepipeline.version",
      "{workspaceRoot}/config/onepipeline-ui.version",
      "{workspaceRoot}/config/onetaskgraph.version",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/config/onevcs.checkouts",
      "{workspaceRoot}/templates/design-doc.md.j2",
      "{workspaceRoot}/graphs/node-scope.yaml",
      "{workspaceRoot}/graphs/pr-author.yaml",
      "{workspaceRoot}/graphs/review-reply.yaml",
      "{workspaceRoot}/scripts/ask-manager-env.sh",
      "{workspaceRoot}/scripts/claude-alt-config-dir.sh",
      "{workspaceRoot}/scripts/codex-alt-home.sh",
      "{workspaceRoot}/scripts/credentials-env.sh",
      "{workspaceRoot}/scripts/dispatch-env-hook.sh",
      "{workspaceRoot}/scripts/dispatch-env.sh",
      "{workspaceRoot}/scripts/template-env.sh",
      "{workspaceRoot}/templates/templates.yaml",
      "{workspaceRoot}/scripts/follow-up-draft.sh",
      "{workspaceRoot}/scripts/follow-up-env.sh",
      "{workspaceRoot}/scripts/follow-ups.sh",
      "{workspaceRoot}/scripts/launcher-session.sh",
      "{workspaceRoot}/scripts/onepipeline.sh",
      "{workspaceRoot}/scripts/orchestrate.sh",
      "{workspaceRoot}/scripts/plan-brief.sh",
      "{workspaceRoot}/scripts/run-ended.sh",
      "{workspaceRoot}/scripts/session-setup.sh",
      "{workspaceRoot}/.claude/settings.json",
      "{workspaceRoot}/orchestrator/follow_up_tickets.py",
      "{workspaceRoot}/orchestrator/plan_store.py",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/orchestrator/plan_units.py",
      "{workspaceRoot}/orchestrator/project_store.py",
      "{workspaceRoot}/tests/unwatched/project.json",
      "{workspaceRoot}/tests/unwatched/test_unwatched_and_stop_hook_e2e.py",
      "{workspaceRoot}/tests/unwatched/test_unwatched_launch_shapes_e2e.py",
      "{workspaceRoot}/config/**/*",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/orchestrator/**/*",
      "{workspaceRoot}/templates/**/*",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/oneharness.dispatch.toml",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/oneharness.judge.toml",
      "{workspaceRoot}/oneharness.plan-review.toml",
      "{workspaceRoot}/oneharness.plan-review-whole.toml",
      "{workspaceRoot}/oneharness.llmlint.toml",
      "{workspaceRoot}/tests/plan_tooling/plan_flow/spike_flow_engine.py",
      "{workspaceRoot}/tests/plan_tooling/plan_flow/copy_quoted_rows.py",
      "{workspaceRoot}/tests/unwatched/budgets.yaml",
      "{workspaceRoot}/tests/unwatched/test_flow_stop_hook_e2e.py",
      "{workspaceRoot}/scripts/ask-manager.sh",
      "{workspaceRoot}/scripts/finish-plan.sh",
      "{workspaceRoot}/scripts/launch-flow.sh",
      "{workspaceRoot}/scripts/lock-timeout.sh",
      "{workspaceRoot}/scripts/plan-check.sh",
      "{workspaceRoot}/scripts/plan-checklist.sh",
      "{workspaceRoot}/scripts/plan-root-env.sh",
      "{workspaceRoot}/scripts/plan-store.sh",
      "{workspaceRoot}/scripts/plan.sh",
      "{workspaceRoot}/scripts/registered-checkouts.sh",
      "{workspaceRoot}/scripts/render-diagram.sh",
      "{workspaceRoot}/scripts/require-provisioned.sh",
      "{workspaceRoot}/scripts/review-plan.sh",
      "{workspaceRoot}/personas/planner.yaml",
      "{workspaceRoot}/personas/design-doc.yaml",
      "{workspaceRoot}/scripts/apply-repo-registry.sh",
      "{workspaceRoot}/scripts/setup-llmlint.sh"
    ]
  },
  "targets": {
    "test": {
      "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] unwatchedWorkspace keys this target on config/, graphs/, orchestrator/ and templates/ whole because tests/unwatched/test_flow_stop_hook_e2e.py runs a real `just plan` flow, whose review, plan check, checklist and launch read each of those trees as a whole (the same four plan-tooling-plan-flow keys its journeys of this flow on), and it copies them into the checkout it runs in: a key narrower than that copy would replay a verdict over files that changed it.",
      "command": "rm -rf .telemetry/unwatched/test && env -u FORCE_COLOR BUDGET_TELEMETRY_DIR=.telemetry/unwatched/test NO_COLOR=1 uv run pytest tests/unwatched --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "unwatchedWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ],
      "outputs": [
        "{workspaceRoot}/.telemetry/unwatched/test"
      ]
    },
    "budgets": {
      "dependsOn": [
        "test"
      ],
      "options": {
        "cwd": ".",
        "env": {
          "BUDGET_TELEMETRY_SOURCES": ".telemetry/unwatched/test"
        }
      },
      "inputs": [
        "{projectRoot}/budgets.yaml",
        "{workspaceRoot}/config/onebudgetspec.version",
        {
          "input": "testSupport",
          "projects": [
            "support-budget-telemetry"
          ]
        },
        {
          "dependentTasksOutputFiles": "**/*.json"
        }
      ]
    },
    "budgets-host": {}
  }
}
