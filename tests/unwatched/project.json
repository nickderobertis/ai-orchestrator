  "targets": {
    "test": {
      "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] unwatchedWorkspace keys this target on config/, graphs/, orchestrator/ and templates/ whole because every `just orchestrate` launch these journeys make runs the launch check its launch config registers, which resolves graphs/planner.yaml's judge bar (its persona, base config and llmlint checklist under config/) and the design-doc template under templates/, and the launch wrapper reads orchestrator/ helpers; a key narrower than what that path opens would replay a verdict over files that changed it.",
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/unwatched --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "unwatchedWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ],
      "outputs": []
    }
  }
}
