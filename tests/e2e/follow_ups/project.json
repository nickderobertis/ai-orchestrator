{
  "name": "follow-ups",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/follow_ups",
  "tags": [
    "scope:follow-ups",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-boundary-home",
    "support-conftest",
    "support-fake-backend",
    "support-fake-codex",
    "support-follow-up-store",
    "support-harness-configs",
    "support-harness-indirections",
    "support-no-paid-provider",
    "support-probe-run-root",
    "support-project-fixtures",
    "support-published-tools",
    "support-scratch-identity",
    "support-sibling-facts"
  ],
  "namedInputs": {
    "followUpsWorkspace": [
      "{workspaceRoot}/onefollowup.yaml",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/budgets.yaml",
      "{workspaceRoot}/config/onebudgetspec.version",
      "{workspaceRoot}/config/onefollowup.version",
      "{workspaceRoot}/config/onepipeline.version",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/orchestrator/**/*",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.onepipeline/config.yaml",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/oneharness.judge.toml",
      "{workspaceRoot}/oneharness.follow-up.toml",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/config/oneagentgraph.version",
      "{workspaceRoot}/config/oneharness.version",
      "{workspaceRoot}/config/onejudge.version",
      "{workspaceRoot}/config/onejudge.base.yaml",
      "{workspaceRoot}/config/onemessagebus.yaml",
      "{workspaceRoot}/config/onepipeline.launch.yaml",
      "{workspaceRoot}/config/onetaskgraph.version",
      "{workspaceRoot}/config/onevcs.releases.yml",
      "{workspaceRoot}/config/onevcs.workspaces.yml",
      "{workspaceRoot}/graphs/follow-up.yaml",
      "{workspaceRoot}/graphs/node-scope.yaml",
      "{workspaceRoot}/personas/follow-up.yaml",
      "{workspaceRoot}/templates/**/*",
      "{workspaceRoot}/scripts/**/*",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/e2e/follow_ups -n 4 --dist loadgroup --no-cov",
      "parallelism": false,
      "options": {
        "cwd": "."
      },
      "inputs": [
        "followUpsWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
