{
  "name": "finalize-guard",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/finalize_guard",
  "tags": [
    "scope:finalize-guard",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest"
  ],
  "namedInputs": {
    "finalizeGuardWorkspace": [
      "{workspaceRoot}/templates/planning/**/*",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/e2e/finalize_guard -n 4 --dist loadgroup --no-cov",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "finalizeGuardWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
