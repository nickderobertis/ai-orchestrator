{
  "name": "release-holdup",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/release_holdup",
  "tags": [
    "scope:release-holdup",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest"
  ],
  "namedInputs": {
    "releaseHoldupWorkspace": [
      "{workspaceRoot}/config/onevcs.releases.yml",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/e2e/release_holdup -n 4 --dist loadgroup --no-cov",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "releaseHoldupWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
