{
  "name": "unpublished-view",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/unpublished_view",
  "tags": [
    "scope:unpublished-view",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-nx-workspace",
    "support-onejudge-bundle",
    "support-probe-run-root",
    "support-run-snapshot",
    "support-unpublished-registry",
    "support-waits"
  ],
  "namedInputs": {
    "unpublishedViewWorkspace": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/config/onemessagebus.yaml",
      "{workspaceRoot}/config/onevcs.checkouts",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/scripts/unpublished.sh",
      "{workspaceRoot}/scripts/launcher-session.sh",
      "{workspaceRoot}/scripts/follow-up-env.sh",
      "{workspaceRoot}/scripts/plan-root-env.sh",
      "{workspaceRoot}/orchestrator/unpublished.py",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/orchestrator/follow_up_drafts.py",
      "{workspaceRoot}/tests/test_engine_contracts.py",
      "{workspaceRoot}/tests/test_linked_libraries.py",
      "{workspaceRoot}/tests/e2e/unpublished_view/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/e2e/unpublished_view --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "unpublishedViewWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
