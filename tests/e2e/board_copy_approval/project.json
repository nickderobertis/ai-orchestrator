{
  "name": "board-copy-approval",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/board_copy_approval",
  "tags": [
    "scope:board-copy-approval",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-boundary-home",
    "support-budget-telemetry",
    "support-conftest",
    "support-fake-codex",
    "support-follow-up-variables",
    "support-github-board",
    "support-no-paid-provider",
    "support-plan-fixture-source",
    "support-plan-root-variable",
    "support-project-fixtures",
    "support-published-tools",
    "support-waits"
  ],
  "namedInputs": {
    "boardCopyApprovalWorkspace": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/orchestrator/run_reading.py",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/oneharness.plan-review.toml",
      "{workspaceRoot}/config/onemessagebus.yaml",
      "{workspaceRoot}/config/onevcs.checkouts",
      "{workspaceRoot}/config/plan-review-verdict.schema.json",
      "{workspaceRoot}/personas/planner.yaml",
      "{workspaceRoot}/scripts/claude-alt-config-dir.sh",
      "{workspaceRoot}/scripts/codex-alt-home.sh",
      "{workspaceRoot}/scripts/credentials-env.sh",
      "{workspaceRoot}/scripts/follow-up-env.sh",
      "{workspaceRoot}/scripts/plan-root-env.sh",
      "{workspaceRoot}/scripts/plan-store.sh",
      "{workspaceRoot}/scripts/review-plan.sh",
      "{workspaceRoot}/templates/design-doc.md.j2",
      "{workspaceRoot}/templates/dispatch-appendix.md",
      "{workspaceRoot}/templates/plan-task.md.j2",
      "{workspaceRoot}/templates/templates.yaml",
      "{workspaceRoot}/orchestrator/adoption_guard.py",
      "{workspaceRoot}/orchestrator/criteria_guard.py",
      "{workspaceRoot}/orchestrator/design_approval.py",
      "{workspaceRoot}/orchestrator/design_chain.py",
      "{workspaceRoot}/orchestrator/follow_up_drafts.py",
      "{workspaceRoot}/orchestrator/follow_up_tickets.py",
      "{workspaceRoot}/orchestrator/host_installs.py",
      "{workspaceRoot}/orchestrator/plan_check.py",
      "{workspaceRoot}/orchestrator/plan_copy.py",
      "{workspaceRoot}/orchestrator/plan_review.py",
      "{workspaceRoot}/orchestrator/plan_store.py",
      "{workspaceRoot}/orchestrator/plan_units.py",
      "{workspaceRoot}/orchestrator/project_store.py",
      "{workspaceRoot}/orchestrator/publication_guard.py",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/orchestrator/structural_guard.py",
      "{workspaceRoot}/orchestrator/task_body.py",
      "{workspaceRoot}/tests/e2e/board_copy_approval/project.json",
      "{workspaceRoot}/tests/e2e/board_copy_approval/test_board_copy_design_approval_e2e.py",
      "{workspaceRoot}/orchestrator/spike_plan.py",
      "{workspaceRoot}/orchestrator/plan_budgets.py",
      "{workspaceRoot}/scripts/plan-check.sh",
      "{workspaceRoot}/templates/spike-report.md.j2",
      "{workspaceRoot}/templates/plan-description.md.j2",
      "{workspaceRoot}/templates/plan-task-budgets.md.j2",
      "{workspaceRoot}/config/budgets-migration.yaml",
      "{workspaceRoot}/tests/e2e/board_copy_approval/test_board_copy_spike_evidence_e2e.py",
      "{workspaceRoot}/tests/e2e/board_copy_approval/test_board_copy_store_reads_e2e.py",
      "{workspaceRoot}/orchestrator/plan_locations.py",
      "{workspaceRoot}/tests/e2e/board_copy_approval/test_board_copy_at_scale_e2e.py"
    ]
  },
  "targets": {
    "test": {
      "command": "rm -rf .telemetry/board-copy-approval/test && env -u FORCE_COLOR BUDGET_TELEMETRY_DIR=.telemetry/board-copy-approval/test NO_COLOR=1 uv run pytest tests/e2e/board_copy_approval --deselect tests/e2e/board_copy_approval/test_board_copy_at_scale_e2e.py::test_approving_a_plan_at_the_plans_boards_scale_records_the_time_a_person_waits --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.telemetry/board-copy-approval/test"
      ],
      "inputs": [
        "boardCopyApprovalWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    },
    "test-host": {
      "command": "rm -rf .telemetry/board-copy-approval/test-host && env -u FORCE_COLOR BUDGET_TELEMETRY_DIR=.telemetry/board-copy-approval/test-host NO_COLOR=1 uv run pytest tests/e2e/board_copy_approval/test_board_copy_at_scale_e2e.py::test_approving_a_plan_at_the_plans_boards_scale_records_the_time_a_person_waits --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "boardCopyApprovalWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ],
      "cache": false,
      "outputs": [
        "{workspaceRoot}/.telemetry/board-copy-approval/test-host"
      ]
    },
    "budgets": {
      "dependsOn": [
        "test"
      ],
      "options": {
        "cwd": ".",
        "env": {
          "BUDGET_TELEMETRY_SOURCES": ".telemetry/board-copy-approval/test"
        }
      },
      "inputs": [
        "{projectRoot}/budgets.yaml",
        "{workspaceRoot}/config/onebudgetspec.version",
        "{workspaceRoot}/scripts/budgets.sh",
        {
          "input": "testSupport",
          "projects": [
            "support-budget-telemetry"
          ]
        },
        {
          "dependentTasksOutputFiles": "**/*.json"
        }
      ]
    },
    "budgets-host": {
      "//": "llmlint: ignore[expensive_tests_stay_behind_their_own_edge] The task labels plan-approval-seconds host and forbids a cache-restored wall clock, and just check runs every host budget whatever the diff, so the fresh measurement this edge pulls in (the test-host approval journey at the plans board's scale, about a minute) runs on every check. A drafted follow-up decides whether host budgets join the diff selection, which would put this journey behind the project's own edge and delete this directive.",
      "dependsOn": [
        "test-host"
      ],
      "options": {
        "cwd": ".",
        "env": {
          "BUDGET_TELEMETRY_SOURCES": ".telemetry/board-copy-approval/test-host"
        }
      }
    }
  }
}
