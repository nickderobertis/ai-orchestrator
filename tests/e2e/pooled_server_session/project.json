{
  "name": "pooled-server-session",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/pooled_server_session",
  "tags": [
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-waits"
  ],
  "namedInputs": {
    "pooledServerSessionWorkspace": [
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/config/oneharness.version",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/e2e/pooled_server_session -n 4 --dist loadgroup --no-cov",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "pooledServerSessionWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
