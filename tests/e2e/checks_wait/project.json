{
  "name": "checks-wait",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/checks_wait",
  "tags": [
    "scope:checks-wait",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-registered-checkouts",
    "support-ruled-registry"
  ],
  "namedInputs": {
    "checksWaitWorkspace": [
      "{workspaceRoot}/config/onevcs.checks-wait.yml",
      "{workspaceRoot}/config/onevcs.rules.yml",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/e2e/checks_wait -n 4 --dist loadgroup --no-cov",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "checksWaitWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
