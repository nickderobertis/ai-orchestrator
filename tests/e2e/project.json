{
  "name": "e2e-root",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e",
  "tags": [
    "scope:e2e-root",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-registered-checkouts",
    "support-scratch-identity",
    "support-sibling-facts"
  ],
  "namedInputs": {
    "e2eRootWorkspace": [
      "{projectRoot}/project.json",
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/config/**/*",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/orchestrator/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/scripts/apply-repo-registry.sh",
      "{workspaceRoot}/scripts/follow-up-env.sh",
      "{workspaceRoot}/scripts/plan-root-env.sh",
      "{workspaceRoot}/scripts/registered-checkouts.sh",
      "{workspaceRoot}/tests/fixtures/pre-adoption-repos.json",
      "{workspaceRoot}/uv.lock",
      "!{workspaceRoot}/orchestrator/**/*.md",
      "{projectRoot}/test_repo_registry_apply_e2e.py"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 COVERAGE_FILE=.coverage.e2e-root uv run pytest tests/e2e/test_repo_registry_apply_e2e.py -n 4 --dist loadgroup --cov=orchestrator --cov-report= --cov-fail-under=0",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.coverage.e2e-root"
      ],
      "inputs": [
        "e2eRootWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
