{
  "name": "budget-gate",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/e2e/budget_gate",
  "tags": [
    "scope:budget-gate",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-follow-up-variables",
    "support-nx-inputs",
    "support-onejudge-bundle",
    "support-onevcs-state-snapshot",
    "support-plan-fixture-source",
    "support-plan-root-variable",
    "support-plan-sources",
    "support-probe-run-root",
    "support-registered-checkouts",
    "support-short-state",
    "support-waits"
  ],
  "namedInputs": {
    "budgetGateWorkspace": [
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/budgets.yaml",
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/config/onebudgetspec.version",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/orchestrator/**/*",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/project.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/templates/design-doc.md.j2",
      "{workspaceRoot}/templates/templates.yaml",
      "{workspaceRoot}/tests/budget_telemetry.py",
      "{workspaceRoot}/tests/fixtures/budgets/**/*",
      "{workspaceRoot}/uv.lock",
      "!{workspaceRoot}/orchestrator/**/*.md",
      "{projectRoot}/**/*"
    ],
    "journeysTheUnitGatesRead": [
      "{projectRoot}/test_budget_target_e2e.py",
      "{projectRoot}/test_gate_time_budget_e2e.py"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 COVERAGE_FILE=.coverage.budget-gate uv run pytest tests/e2e/budget_gate -n 4 --dist loadgroup --cov=orchestrator --cov-report= --cov-fail-under=0",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.coverage.budget-gate"
      ],
      "inputs": [
        "budgetGateWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
