{
  "name": "plan-tooling-plan-flow",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/plan_tooling/plan_flow",
  "tags": [
    "scope:plan-tooling-plan-flow",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-boundary-home",
    "support-conftest",
    "support-fake-backend",
    "support-fake-codex",
    "support-follow-up-boundary",
    "support-follow-up-ticket-shape",
    "support-follow-up-variables",
    "support-github-board",
    "support-no-paid-provider",
    "support-nx-inputs",
    "support-nx-workspace",
    "support-onejudge-bundle",
    "support-onetaskgraph-user-layer",
    "support-onevcs-state-snapshot",
    "support-plan-fixture-source",
    "support-plan-root-variable",
    "support-plan-sources",
    "support-plan-store-cache",
    "support-plan-store-user-layer",
    "support-project-fixtures",
    "support-published-tools",
    "support-pytest-temp-root",
    "support-registered-checkouts",
    "support-scratch-identity",
    "support-short-state",
    "support-waits"
  ],
  "namedInputs": {
    "planToolingPlanFlowWorkspace": [
      "{workspaceRoot}/.gitignore",
      "{workspaceRoot}/.puppeteerrc.json",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/oneharness.dispatch.toml",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/oneharness.judge.toml",
      "{workspaceRoot}/oneharness.design-doc.toml",
      "{workspaceRoot}/oneharness.design-doc-judge.toml",
      "{workspaceRoot}/oneharness.plan-review.toml",
      "{workspaceRoot}/oneharness.plan-review-whole.toml",
      "{workspaceRoot}/.githooks/pre-push",
      "{workspaceRoot}/personas/design-doc.yaml",
      "{workspaceRoot}/personas/planner.yaml",
      "{workspaceRoot}/scripts/apply-repo-registry.sh",
      "{workspaceRoot}/scripts/ask-manager-env.sh",
      "{workspaceRoot}/scripts/ask-manager.sh",
      "{workspaceRoot}/scripts/claude-alt-config-dir.sh",
      "{workspaceRoot}/scripts/codex-alt-home.sh",
      "{workspaceRoot}/scripts/credentials-env.sh",
      "{workspaceRoot}/scripts/dispatch-env-hook.sh",
      "{workspaceRoot}/scripts/dispatch-env.sh",
      "{workspaceRoot}/scripts/finish-plan.sh",
      "{workspaceRoot}/scripts/follow-up-env.sh",
      "{workspaceRoot}/scripts/follow-ups.sh",
      "{workspaceRoot}/scripts/launcher-session.sh",
      "{workspaceRoot}/scripts/launch-flow.sh",
      "{workspaceRoot}/scripts/lock-timeout.sh",
      "{workspaceRoot}/scripts/onepipeline.sh",
      "{workspaceRoot}/scripts/orchestrate.sh",
      "{workspaceRoot}/scripts/plan-brief.sh",
      "{workspaceRoot}/scripts/plan-check.sh",
      "{workspaceRoot}/scripts/plan-root-env.sh",
      "{workspaceRoot}/scripts/plan-store.sh",
      "{workspaceRoot}/scripts/plan.sh",
      "{workspaceRoot}/scripts/registered-checkouts.sh",
      "{workspaceRoot}/scripts/render-diagram.sh",
      "{workspaceRoot}/scripts/review-plan.sh",
      "{workspaceRoot}/scripts/run-ended.sh",
      "{workspaceRoot}/scripts/template-env.sh",
      "{workspaceRoot}/graphs/**/*",
      "{workspaceRoot}/config/**/*",
      "{workspaceRoot}/templates/**/*",
      "{workspaceRoot}/orchestrator/**/*",
      "{workspaceRoot}/tests/fixtures/design_doc/**/*",
      "{workspaceRoot}/tests/plan_tooling/plan_flow/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 COVERAGE_FILE=.coverage.plan-tooling-plan-flow uv run pytest tests/plan_tooling/plan_flow -m 'not reads_docs' -n 4 --dist loadgroup --cov=orchestrator --cov-report= --cov-fail-under=0",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.coverage.plan-tooling-plan-flow"
      ],
      "inputs": [
        "planToolingPlanFlowWorkspace",
        {
          "input": "testSupport",
          "projects": [
            "support-boundary-home",
            "support-conftest",
            "support-fake-backend",
            "support-fake-codex",
            "support-follow-up-boundary",
            "support-follow-up-ticket-shape",
            "support-follow-up-variables",
            "support-github-board",
            "support-no-paid-provider",
            "support-nx-inputs",
            "support-nx-workspace",
            "support-onejudge-bundle",
            "support-onetaskgraph-user-layer",
            "support-onevcs-state-snapshot",
            "support-plan-fixture-source",
            "support-plan-root-variable",
            "support-plan-sources",
            "support-plan-store-cache",
            "support-plan-store-user-layer",
            "support-project-fixtures",
            "support-published-tools",
            "support-pytest-temp-root",
            "support-registered-checkouts",
            "support-scratch-identity",
            "support-short-state",
            "support-waits"
          ]
        }
      ]
    },
    "test-docs": {
      "command": "rm -rf .telemetry/plan-tooling-plan-flow/test-docs && env -u FORCE_COLOR BUDGET_TELEMETRY_DIR=.telemetry/plan-tooling-plan-flow/test-docs NO_COLOR=1 uv run pytest tests/plan_tooling/plan_flow -m reads_docs --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "wholeWorkspace"
      ],
      "outputs": [
        "{workspaceRoot}/.telemetry/plan-tooling-plan-flow/test-docs"
      ]
    }
  }
}
