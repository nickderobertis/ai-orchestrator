{
  "name": "plan-tooling-host-layer-routing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/plan_tooling/host_layer_routing",
  "tags": [
    "scope:plan-tooling-host-layer-routing",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-boundary-home",
    "support-conftest",
    "support-github-board",
    "support-linear-board",
    "support-onetaskgraph-user-layer",
    "support-published-tools",
    "support-waits"
  ],
  "namedInputs": {
    "planToolingHostLayerRoutingWorkspace": [
      "{workspaceRoot}/config/onemessagebus.yaml",
      "{workspaceRoot}/config/onetaskgraph.user-layer.example.yaml",
      "{workspaceRoot}/config/onetaskgraph.version",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/oneharness.identities.toml",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/orchestrator/gate_impact.py",
      "{workspaceRoot}/orchestrator/host_installs.py",
      "{workspaceRoot}/orchestrator/npm_installs.py",
      "{workspaceRoot}/orchestrator/plan_store.py",
      "{workspaceRoot}/orchestrator/record_shapes.py",
      "{workspaceRoot}/orchestrator/redaction.py",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/orchestrator/run_reading.py",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/scripts/claude-alt-config-dir.sh",
      "{workspaceRoot}/scripts/codex-alt-home.sh",
      "{workspaceRoot}/scripts/credentials-env.sh",
      "{workspaceRoot}/scripts/follow-up-draft.sh",
      "{workspaceRoot}/scripts/follow-up.sh",
      "{workspaceRoot}/scripts/launcher-session.sh",
      "{workspaceRoot}/scripts/onepipeline.sh",
      "{workspaceRoot}/config/onepipeline.launch.yaml",
      "{workspaceRoot}/scripts/plan-store.sh",
      "{workspaceRoot}/scripts/require-provisioned.sh",
      "{workspaceRoot}/scripts/template-env.sh",
      "{workspaceRoot}/templates/templates.yaml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/tests/plan_tooling/host_layer_routing/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 COVERAGE_FILE=.coverage.plan-tooling-host-layer-routing uv run pytest tests/plan_tooling/host_layer_routing -n 4 --dist loadgroup --cov=orchestrator --cov-report= --cov-fail-under=0",
      "options": {
        "cwd": "."
      },
      "outputs": [
        "{workspaceRoot}/.coverage.plan-tooling-host-layer-routing"
      ],
      "inputs": [
        "planToolingHostLayerRoutingWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
