{
  "name": "merge-policy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/merge_policy",
  "tags": [
    "scope:merge-policy",
    "type:tests"
  ],
  "implicitDependencies": [
    "support-conftest",
    "support-fake-backend",
    "support-fake-codex",
    "support-harness-indirections",
    "support-no-paid-provider",
    "support-nx-workspace",
    "support-project-fixtures",
    "support-short-state",
    "support-waits"
  ],
  "namedInputs": {
    "mergePolicyWorkspace": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/justfile",
      "{workspaceRoot}/AGENTS.md",
      "{workspaceRoot}/docs/orchestration.md",
      "{workspaceRoot}/docs/repo-lifecycle.md",
      "{workspaceRoot}/onetaskgraph.yaml",
      "{workspaceRoot}/oneharness.check-in.toml",
      "{workspaceRoot}/oneharness.pr-author.toml",
      "{workspaceRoot}/config/oneagentgraph.version",
      "{workspaceRoot}/config/oneharness.version",
      "{workspaceRoot}/config/onejudge.version",
      "{workspaceRoot}/config/onemessagebus.yaml",
      "{workspaceRoot}/config/onepipeline.version",
      "{workspaceRoot}/config/onepipeline-ui.version",
      "{workspaceRoot}/config/onetaskgraph.version",
      "{workspaceRoot}/config/onevcs.version",
      "{workspaceRoot}/config/onevcs.checkouts",
      "{workspaceRoot}/config/design-doc-template.md",
      "{workspaceRoot}/graphs/pr-author.yaml",
      "{workspaceRoot}/scripts/ask-manager-env.sh",
      "{workspaceRoot}/scripts/claude-alt-config-dir.sh",
      "{workspaceRoot}/scripts/codex-alt-home.sh",
      "{workspaceRoot}/scripts/credentials-env.sh",
      "{workspaceRoot}/scripts/dispatch-env-hook.sh",
      "{workspaceRoot}/scripts/dispatch-env.sh",
      "{workspaceRoot}/scripts/follow-up-draft.sh",
      "{workspaceRoot}/scripts/follow-up-env.sh",
      "{workspaceRoot}/scripts/follow-ups.sh",
      "{workspaceRoot}/scripts/launcher-session.sh",
      "{workspaceRoot}/scripts/onepipeline.sh",
      "{workspaceRoot}/scripts/orchestrate.sh",
      "{workspaceRoot}/scripts/plan-brief.sh",
      "{workspaceRoot}/scripts/run-ended.sh",
      "{workspaceRoot}/scripts/session-setup.sh",
      "{workspaceRoot}/orchestrator/design_approval.py",
      "{workspaceRoot}/orchestrator/follow_up_tickets.py",
      "{workspaceRoot}/orchestrator/plan_store.py",
      "{workspaceRoot}/orchestrator/project_store.py",
      "{workspaceRoot}/orchestrator/root.py",
      "{workspaceRoot}/tests/merge_policy/**/*"
    ]
  },
  "targets": {
    "test": {
      "command": "env -u FORCE_COLOR NO_COLOR=1 uv run pytest tests/merge_policy --no-cov -n 4 --dist loadgroup",
      "options": {
        "cwd": "."
      },
      "inputs": [
        "mergePolicyWorkspace",
        {
          "input": "testSupport",
          "dependencies": true
        }
      ]
    }
  }
}
